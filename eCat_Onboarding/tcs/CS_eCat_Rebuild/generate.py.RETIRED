# RETIRED 2026-06-11: CSVs are now the source of truth and are edited directly. Do NOT re-run this — it will overwrite manual fixes (ShortDesc, CDN images, option assignments).
#!/usr/bin/env python3
"""
CopperSmith eCat rebuild generator.

Source of truth:
  - CS_Master_Product_List_June_2026_UPDATE (1)/Master Sheet E+G-Table 1.csv  (283 child SKUs)
  - CS_Master_Product_List_June_2026_UPDATE (1)/Weiyan LED-Table 1.csv         (96 LED SKUs)
Curated (prices/names/categories already validated by the builder):
  - options (2).csv, option_groups (1).csv, products (4).csv

What this does:
  1. Categorizes every option by the curated options.csv `Description` (conflict-free, priced).
  2. Splits the mixed Mount (M###) + Gas/Electric (GE###) groups into 8 single-type families:
       1 Finish | 2 Wall Mount | 3 Wall Accessories | 4 Ceiling Mount
       5 Post & Pier Mount | 6 Decorative | 7 Electric | 8 Gas
  3. Re-buckets each existing product's option membership into OptionSet1..8.
  4. Adds the 96 Weiyan LED products (electric, no gas) wired from the Weiyan tab columns.
  5. Fixes: FIN copper set now includes CLEAR; HSI1=Frosted / HSI2=Sanded names;
     ShortDesc misuse (moved to custom ShortDescription, real ShortDesc dropped);
     fills the 16 blank ImageFileName values from master Main Image File Name.
"""
import csv, re, collections, os, unicodedata

SRC = "../Source Data/"
MASTER = SRC + "Master Sheet E+G-Table 1.csv"
WEIYAN = SRC + "Weiyan LED-Table 1.csv"
OPTS_IN = SRC + "options (2).csv"
GRPS_IN = SRC + "option_groups (1).csv"
PROD_IN = SRC + "products (4).csv"

def nkey(s):
    """Normalize a SKU for matching (collapses NBSP/odd whitespace via NFKC)."""
    return unicodedata.normalize("NFKC", s or "").strip()

OUT_DIR = "."

# ---- type system -----------------------------------------------------------
DESC2TYPE = {
    "FINISH": "Finish",
    "WALL MOUNT": "Wall Mount",
    "WALL ACCESSORIES": "Wall Accessories",
    "CEILING MOUNT": "Ceiling Mount",
    "POST & PIER MOUNT": "Post & Pier Mount",
    "DECORATIVE OPTIONS": "Decorative",
    "ELECTRIC": "Electric",
    "GAS": "Gas",
}
# OptionSet number + group-code prefix per type
TYPE_SLOT = {
    "Finish": (1, "FIN"),
    "Wall Mount": (2, "WM"),
    "Wall Accessories": (3, "WA"),
    "Ceiling Mount": (4, "CM"),
    "Post & Pier Mount": (5, "PP"),
    "Decorative": (6, "DEC"),
    "Electric": (7, "ELE"),
    "Gas": (8, "GAS"),
}
NONFIN_TYPES = [t for t in TYPE_SLOT if t != "Finish"]

# ---- option swatches: reuse existing live option_images library (no uploads) ----
# Generic family swatches already present in org 291's option_images table.
EXISTING_SWATCHES = set("""blk brass brz copper gray gnp gns cy coy py chm qcm cpm sm ee
dsm fm ft sp lt lb fdf bbr chb bs ts rbs fh bfh plr pfp hsi tla wg moneotophook eli_2 cm""".split())

def swatch_for(code):
    """Map an option code to an EXISTING live family swatch. Returns (file, confidence)."""
    c = code.upper()
    fin = {"BLK": "blk", "BRZ": "brz", "GRAY": "gray", "COPPER": "copper", "BRASS": "brass"}
    if c in fin:
        return fin[c], "high"
    rules = [
        (r"^GNP\d", "gnp", "high"), (r"^GNS\d", "gns", "high"), (r"^CY\d", "cy", "high"),
        (r"^COY\d", "coy", "high"), (r"^PY\d", "py", "high"), (r"^CHM$", "chm", "high"),
        (r"^QCM$", "qcm", "high"), (r"^CPM\d", "cpm", "high"), (r"^SM$", "sm", "high"),
        (r"^EE\d", "ee", "high"), (r"^DSM[SL]$", "dsm", "high"), (r"^FM[SL]$", "fm", "high"),
        (r"^FT\d", "ft", "high"), (r"^SP$", "sp", "high"), (r"^SPAM\d", "sp", "high"),
        (r"^LT[SL]$", "lt", "high"), (r"^LB[SL]$", "lb", "high"), (r"^FDF$", "fdf", "high"),
        (r"^BBR$", "bbr", "high"), (r"^CHB", "chb", "high"), (r"^BS\d", "bs", "high"),
        (r"^BS36$", "bs", "high"), (r"^TS\d", "ts", "high"), (r"^TS36$", "ts", "high"),
        (r"^TSG\d", "ts", "high"), (r"^RBS\d", "rbs", "high"), (r"^FH\d", "fh", "high"),
        (r"^BFH\d", "bfh", "high"), (r"^PLR$", "plr", "high"), (r"^MOT[SL]$", "moneotophook", "high"),
        (r"^HSI[12]$", "hsi", "high"), (r"^TLA$", "tla", "high"), (r"^WG[SL]$", "wg", "high"),
        (r"^ELI$", "eli_2", "high"),
    ]
    for pat, sw, conf in rules:
        if re.match(pat, c):
            return sw, conf
    return None, None

# ---- load curated option catalog ------------------------------------------
with open(OPTS_IN, newline="", encoding="utf-8-sig") as f:
    options = {r["Code"].strip(): dict(r) for r in csv.DictReader(f)}

# HSI name fix
if "HSI1" in options: options["HSI1"]["Name"] = "Frosted Hurricane Shade"
if "HSI2" in options: options["HSI2"]["Name"] = "Sanded Hurricane Shade"

# London Bottom code/name swap correction (source had LBS=Large, LBL=Small; LTS/LTL are correct)
if "LBS" in options: options["LBS"]["Name"] = "London Bottom Small"
if "LBL" in options: options["LBL"]["Name"] = "London Bottom Large"

def code_type(code):
    d = options.get(code, {}).get("Description", "").strip().upper()
    return DESC2TYPE.get(d)

with open(GRPS_IN, newline="", encoding="utf-8-sig") as f:
    group_members = {r["Code"].strip(): [c.strip() for c in r["Options"].split(",") if c.strip()]
                     for r in csv.DictReader(f)}

with open(PROD_IN, newline="", encoding="utf-8-sig") as f:
    products = [dict(r) for r in csv.DictReader(f)]

VALID = set(options)

# ---- finish sets (corrected) -----------------------------------------------
FIN_COPPER = ["COPPER", "BLK", "BRZ", "GRAY", "CLEAR"]   # was missing CLEAR
FIN_BRASS = ["BRASS", "CLEAR"]

# ---- taxonomy (AUTO-CREATE OFF: product file references existing Admin CODES) ----
# Codes below match what already exists in org `tcs` Admin (verified live), so the
# product file links to them directly. With auto-create off, CategoryCodes may be a
# comma-separated list -> a product shows under MULTIPLE Product Types (the whole
# point of the switch). Groups (OL/ACC) are assigned in Admin via the category parent.
DEFAULT_BRAND = "The CopperSmith"

# verified data-quality fix in the E+G master: doubled-brand typo merges into one collection
COLLECTION_FIX = {
    "Biltmore\u00ae Biltmore\u00ae Flush Traveler": "Biltmore\u00ae Flush Traveler",
}

def slug(s):
    s = unicodedata.normalize("NFKC", s or "").replace("\u00ae", "")
    return re.sub(r"[^A-Za-z0-9]+", "_", s).strip("_").upper()

TRADENAME_CODE = {"The CopperSmith": "TN1", "The CopperSmith Biltmore\u00ae": "TN2"}

# Fixture Sub-Type token -> Admin category code (multi-category now allowed).
# Pendant Lights intentionally omitted (not in the client nav).
TOKEN_CODE = {
    "Gas Lanterns": "CAT5", "Electric Lanterns": "CAT4", "Flush Mount": "CAT3",
    "RLM Lighting": "CAT2", "Sconce": "CAT1", "Wildlife Friendly": "CAT6",
}
WEIYAN_CAT_CODE = "CAT7"
ACC_COLLECTION_CODE = "COL48"                              # NEW: 'Accessories' collection (under CS)
ACC_CAT_CODE = {"ELECTRIC": "CAT8", "GAS": "CAT9", "BULBS": "CAT10"}

# existing live collection codes (slug(display name) -> COL code), org `tcs`
COLLECTION_CODE = {
    "ADAM_STREET": "COL8", "ARCADIA": "COL2", "AUSTIN": "COL9", "AUSTIN_FLUSH": "COL19",
    "BAYOU_STREET": "COL11", "BELMONT": "COL10", "CHURCHILL": "COL12",
    "COASTAL_WALL_SCONCE": "COL15", "CONCEPTION_STREET": "COL14", "CONTEMPO": "COL13",
    "CONTEMPO_FLUSH_MOUNT": "COL20", "DINARDI": "COL16", "EAST_BAY": "COL17",
    "ESLAVA_STREET": "COL18", "GEORGETOWN": "COL25", "HAWTHORN": "COL26", "HYLAND": "COL27",
    "HYLAND_FLUSH": "COL22", "HYLAND_FLUSH_MOUNT": "COL21", "ISLAMORADA_RLM": "COL28",
    "JUNIPER": "COL29", "KEY_LARGO_RLM": "COL30", "KEY_WEST_RLM": "COL31",
    "MARKET_STREET": "COL33", "MONEO": "COL32", "MOUNT_VERNON": "COL34", "NAVARRETE": "COL35",
    "OAKLEY": "COL36", "PALMETTO_STREET": "COL39", "PEBBLE_HILL": "COL38", "PINNACLE": "COL37",
    "SOMERSET": "COL40", "STATE_STREET": "COL41", "TERRA": "COL42",
    "TURTLE_FRIENDLY_WALL_SCONCES": "COL1", "VIERA": "COL45", "WATER_STREET": "COL46",
    "YORKTOWN": "COL47", "BILTMORE_AMHERST": "COL4", "BILTMORE_ANTLER_HILL": "COL3",
    "BILTMORE_APPROACH": "COL6", "BILTMORE_ARCUS": "COL7", "BILTMORE_AURORA": "COL5",
    "BILTMORE_FLUSH_TRAVELER": "COL23", "BILTMORE_GALA": "COL24", "BILTMORE_VESTIBULE": "COL44",
    "TRAVELER": "COL43",
}
# nice label per code -> emitted into the Admin-setup reference (rename/reparent/create)
TAXONOMY_NICE = {
    "TN1": ("TradeName", "", "The CopperSmith"),
    "TN2": ("TradeName", "", "The CopperSmith Biltmore\u00ae"),
    "OL":  ("Group", "", "Outdoor Lighting"),
    "ACC": ("Group", "", "Accessories"),
    "CAT5": ("Category", "OL", "Gas Lanterns"), "CAT4": ("Category", "OL", "Electric Lanterns"),
    "CAT3": ("Category", "OL", "Flush Mount"), "CAT2": ("Category", "OL", "RLM Lighting"),
    "CAT1": ("Category", "OL", "Sconces"), "CAT6": ("Category", "OL", "Wildlife Friendly"),
    "CAT7": ("Category", "OL", "LED Fixtures"),
    "CAT8": ("Category", "ACC", "Electric Accessories"),
    "CAT9": ("Category", "ACC", "Gas Accessories"), "CAT10": ("Category", "ACC", "Light Bulbs"),
}

# ---- master sheet helpers --------------------------------------------------
def load_sheet(path):
    with open(path, newline="", encoding="utf-8-sig") as f:
        rows = list(csv.reader(f))
    sec, hdr, data = rows[0], rows[1], rows[2:]
    fill, cur = [], ""
    for s in sec:
        if s.strip(): cur = s.strip()
        fill.append(cur)
    return fill, hdr, [r for r in data if r and len(r) > 0 and r[0].strip()]

def col_finder(hdr):
    norm = [h.strip().lower() for h in hdr]
    def find(*cands):
        for c in cands:
            cl = c.strip().lower()
            if cl in norm:
                return norm.index(cl)
        for c in cands:                    # loose contains
            cl = c.strip().lower()
            for i, h in enumerate(norm):
                if cl and cl in h:
                    return i
        return None
    return find

STOP = {"----", "yes", "no", "n/a", "na", "configuration available", ""}

# Source-sheet codes that are the same item under a different code in the catalog.
CODE_ALIAS = {"QCHM": "QCM"}   # QCHM (Weiyan tab) == QCM (Quartet Chain Mount)

def sku_option_codes(fill, hdr, row):
    """Return valid option codes present in this SKU's option-block columns."""
    out = []
    for i, sl in enumerate(fill):
        if sl in ("WALL MOUNT", "WALL ACCESSORIES (only available on standard wall mount)",
                  "WALL ACCESSORIES", "CEILING MOUNT", "POST & PIER MOUNT",
                  "DECORATIVE OPTIONS", "ELECTRIC", "GAS"):
            if i < len(row):
                v = CODE_ALIAS.get(row[i].strip(), row[i].strip())
                if v.lower() not in STOP and v in VALID:
                    out.append(v)
    return out

def bucket(codes):
    """Bucket a list of option codes into single-type ordered, de-duped lists."""
    b = {t: [] for t in NONFIN_TYPES}
    for c in codes:
        t = code_type(c)
        if t and t in b and c not in b[t]:
            b[t].append(c)
    return b

# ---- collect per-product non-finish buckets + finish body ------------------
# product_key -> {type: [codes]} and finish body ('copper'/'brass')
prod_buckets = {}
prod_finish = {}

# existing 271 products: membership = union of their current option groups
for p in products:
    sku = p["BaseItemCode"].strip()
    codes = []
    for n in range(1, 6):
        for g in (p.get(f"OptionSet{n}", "") or "").split(","):
            g = g.strip()
            if g:
                codes.extend(group_members.get(g, []))
    prod_buckets[sku] = bucket(codes)
    prod_finish[sku] = "brass" if (p.get("OptionSet1", "").strip() == "FIN002") else "copper"

# ---- (#4) MS-line decorative additions (per workbench spec) ----------------
# Market Street lines also carry London Top Small, London Bottom Small, Fleur De Lis.
MS_DECOR_ADD = ["LTS", "LBS", "FDF"]
for sku, b in prod_buckets.items():
    if re.match(r"^MS\d", sku.upper()):
        for c in MS_DECOR_ADD:
            if c in VALID and c not in b["Decorative"]:
                b["Decorative"].append(c)

# ---- build Weiyan product records ------------------------------------------
fillW, hdrW, dataW = load_sheet(WEIYAN)
fW = col_finder(hdrW)
W = {
    "sku": fW("SKU"), "parent": fW("Parent SKU"), "name": fW("Retailer Product Name"),
    "brand": fW("Brand Name"),
    "upc": fW("UPC/GTIN", "UPC"), "cat": fW("Fixture Type"), "coll": fW("Collection"),
    "style": fW("Fixture Style", "Primary Genre/ Style"), "power": fW("Power Source"),
    "mat": fW("Material"), "deffin": fW("Default Finish"), "secfin": fW("Secondary Finish"),
    "glass": fW("Glass Features"),
    "msrp": fW("MSRP/ List Price", "MSRP"), "map": fW("MAP/ IMAP"),
    "net": fW("Dealer Net "), "h": fW("Height (inches)"), "w": fW("Width (inches)"),
    "d": fW("Depth (inches)"), "ext": fW("Extension (inches)"),
    "bpw": fW("Backplate Width  (inches)", "Backplate Width (inches)"),
    "bph": fW("Backplate Height  (inches)", "Backplate Height (inches)"),
    "cpw": fW("Canopy Width  (inches)", "Canopy Width (inches)"), "cph": fW("Canopy Height"),
    "shipwt": fW("Shipping Weight (lbs)"), "bbase": fW("Bulb Base"), "bcount": fW("Bulb Count"),
    "wpb": fW("Watts Per Bulb"), "tw": fW("Total Wattage"), "volt": fW("Voltage", "Total Voltage"),
    "binc": fW("Bulb Included"), "btr": fW("Bulb Type Required"), "marine": fW("Marine Grade"),
    "darksky": fW("Dark Sky", "Dark Sky Friendly"), "loc": fW("Location Rating"), "ada": fW("ADA"),
    "cert": fW("Certifications"), "t20": fW("Title 20"), "t24": fW("Title 24"), "p65": fW("Prop 65"),
    "img": fW("Main Image File Name"), "spec": fW("Spec Sheet SKU"),
    "short": fW("Short Description"), "mktg": fW("Marketing Copy"),
    "warr": fW("Warranty"), "coo": fW("Country of Origin"),
}

def g(row, idx):
    return row[idx].strip() if (idx is not None and idx < len(row)) else ""

BRAND_RE = re.compile(r"^(the\s+)?coppersmith\s+", re.I)
FINISH_SUFFIX_RE = re.compile(
    r"\s+in\s+(antique copper|antique brass|aged brass|brass|copper|graphite gray|"
    r"matte black|oil rubbed bronze|clear coat|clear)\s*$", re.I)

def make_longdesc(name, default_finish=""):
    """Catalog title from the source Retailer Product Name: keep the CopperSmith
    brand prefix (normalized), drop ® and the trailing ' in <finish>'. Field holds
    255 chars, so no truncation is needed."""
    s = name.replace("\u00ae", "").strip()           # drop ®
    s = BRAND_RE.sub("CopperSmith ", s)              # normalize brand prefix (keep it)
    if default_finish:
        s = re.sub(r"\s+in\s+" + re.escape(default_finish.strip()) + r"\s*$", "", s, flags=re.I)
    s = FINISH_SUFFIX_RE.sub("", s)
    s = re.sub(r"\s{2,}", " ", s).strip()
    return s[:255]

def dims(h, w, d):
    parts = []
    if h: parts.append(f'{h}"H')
    if w: parts.append(f'{w}"W')
    if d: parts.append(f'{d}"D')
    return " x ".join(parts)

weiyan_rows = []
weiyan_unknown = collections.Counter()
for r in dataW:
    sku = g(r, W["sku"])
    if not sku:
        continue
    # option codes from columns
    codes = sku_option_codes(fillW, hdrW, r)
    # log code-like cells that aren't valid options
    for i, sl in enumerate(fillW):
        if sl in ("WALL MOUNT", "WALL ACCESSORIES", "CEILING MOUNT", "POST & PIER MOUNT",
                  "DECORATIVE OPTIONS", "ELECTRIC", "GAS") and i < len(r):
            v = CODE_ALIAS.get(r[i].strip(), r[i].strip())
            if v.lower() not in STOP and v not in VALID and re.match(r"^[A-Za-z0-9_\-]{1,15}$", v):
                weiyan_unknown[v] += 1
    prod_buckets[sku] = bucket(codes)
    deffin = g(r, W["deffin"])
    prod_finish[sku] = "brass" if "brass" in deffin.lower() else "copper"
    img = g(r, W["img"])
    cat = {"Wall Lantern": "Wall Sconce", "Flush Mount": "Ceiling Mount"}.get(
        g(r, W["cat"]), g(r, W["cat"]))
    weiyan_rows.append({
        "BaseItemCode": sku,
        "LongDesc": make_longdesc(g(r, W["name"]), deffin),
        "ShortDesc": g(r, W["short"]),
        "TradeNameCode": g(r, W["brand"]) or "The CopperSmith",
        "CollectionCodes": g(r, W["coll"]) or "Weiyan LED",
        "CategoryCodes": "LED Fixtures",
        "materials": g(r, W["mat"]),
        "dimensions": dims(g(r, W["h"]), g(r, W["w"]), g(r, W["d"])),
        "shipweight": g(r, W["shipwt"]),
        "UPCValue": g(r, W["upc"]),
        "ImageFileName": (img.lower() + ".jpg") if img else "",
        "NetPrice": g(r, W["net"]).replace("$", "").replace(",", ""),
        "Price_MAP": g(r, W["map"]).replace("$", "").replace(",", ""),
        "Price_MSRP": g(r, W["msrp"]).replace("$", "").replace(",", ""),
        "Genre": "",
        "Subcategory": g(r, W["style"]),
        "GasElectricDual": "Electric",
        "SecondaryFinish": g(r, W["secfin"]),
        "GlassFeatures": g(r, W["glass"]),
        "Extension": g(r, W["ext"]), "BackplateWidth": g(r, W["bpw"]),
        "BackplateHeight": g(r, W["bph"]), "CanopyWidth": g(r, W["cpw"]),
        "CanopyHeight": g(r, W["cph"]), "BulbBase": g(r, W["bbase"]),
        "BulbCount": g(r, W["bcount"]), "WattsPerBulb": g(r, W["wpb"]),
        "TotalWattage": g(r, W["tw"]), "Voltage": g(r, W["volt"]),
        "BulbIncluded": g(r, W["binc"]), "BulbTypeRequired": g(r, W["btr"]),
        "MarineGrade": g(r, W["marine"]), "DarkSky": g(r, W["darksky"]),
        "LocationRating": g(r, W["loc"]), "ADA": g(r, W["ada"]),
        "Certifications": g(r, W["cert"]), "Title20": g(r, W["t20"]),
        "Title24": g(r, W["t24"]), "Prop65": g(r, W["p65"]),
        "SpecSheet": g(r, W["spec"]), "MarketingCopy": g(r, W["mktg"]),
        "Warranty": g(r, W["warr"]), "CountryOfOrigin": g(r, W["coo"]),
    })

# ---- Weiyan listing structure: smallest size = visible hero, others hidden, ----
# ---- family render reused as the image, RelatedItems cross-link, Outdoor LED tag ----
RENDER_DIR = "../CopperSmith Weiyan LED Flame"
sku2parent = {g(r, W["sku"]).strip(): g(r, W["parent"]).strip() for r in dataW if g(r, W["sku"]).strip()}

def _size_num(s):
    m = re.search(r"(\d+)", s)
    return int(m.group(1)) if m else 0

fam_members = collections.defaultdict(list)
for w in weiyan_rows:
    fam_members[sku2parent.get(w["BaseItemCode"], w["BaseItemCode"])].append(w["BaseItemCode"])
fam_hero = {fam: min(mem, key=_size_num) for fam, mem in fam_members.items()}

# map family -> render file from supplied JPGs (skip parenthesized / .2 duplicates)
fam_render = {}
if os.path.isdir(RENDER_DIR):
    for fn in sorted(os.listdir(RENDER_DIR)):
        if not fn.lower().endswith(".jpg"):
            continue
        base = fn[:-4]
        if "(" in base or "." in base:                  # GT20W(LA), VB35W.2 -> not a primary render
            continue
        fam = sku2parent.get(base.upper())
        if fam:
            fam_render.setdefault(fam, []).append(fn.lower())

def weiyan_image(sku, fam):
    if fam == "TR-W":                                    # Traveler split per client decision
        return "tr31w.jpg" if sku.upper() == "TR31W" else "tr25w.jpg"
    r = fam_render.get(fam, [])
    return r[0] if r else ""

for w in weiyan_rows:
    sku = w["BaseItemCode"]; fam = sku2parent.get(sku, sku)
    w["ImageFileName"] = weiyan_image(sku, fam)
    w["Hideable"] = "N" if sku == fam_hero.get(fam) else "Y"
    w["RelatedItems"] = ",".join(m for m in fam_members[fam] if m != sku)
    # CategoryCodes already set to "LED Fixtures" at construction (nav-spec Product Type)

# ---- master Main Image File Name lookup (to fill blanks on existing prods) --
fillM, hdrM, dataM = load_sheet(MASTER)
fM = col_finder(hdrM)
m_sku, m_img = fM("SKU"), fM("Main Image File Name")
m_name, m_deffin = fM("Retailer Product Name"), fM("Default Finish")
m_brand = fM("Brand Name")
m_coll = fM("Collection")
m_subtype = fM("Fixture Sub-Type (Additional Filtering Options)", "Fixture Sub-Type", "Fixture SubType")
master_img = {}
master_name = {}   # sku -> (retailer product name, default finish) for brand-prefixed LongDesc
master_tax = {}    # nkey(sku) -> {brand, collection, subtype} for the taxonomy rebuild
for r in dataM:
    s = g(r, m_sku)
    if s:
        master_img[s] = g(r, m_img)
        master_name[s] = (g(r, m_name), g(r, m_deffin))
        master_tax[nkey(s)] = {
            "brand": g(r, m_brand),
            "collection": g(r, m_coll),
            "subtype": g(r, m_subtype),
        }

# collection -> brand (from the E+G master) so a collection lives under ONE brand tier.
# Weiyan rows default their brand to "The CopperSmith"; realign any that sit in a
# Biltmore collection so the collection doesn't appear under both brand headers.
coll2brand = {}
for r in dataM:
    coll, brand = g(r, m_coll), g(r, m_brand)
    if coll and brand:
        coll2brand.setdefault(coll, brand)
for w in weiyan_rows:
    b = coll2brand.get(w["CollectionCodes"])
    if b:
        w["TradeNameCode"] = b

# ---- taxonomy code helpers (auto-create OFF: emit Admin codes) -------------
def fix_coll(name):
    name = nkey(name)
    return COLLECTION_FIX.get(name, name)

def brand_name(b):
    return nkey(b) or DEFAULT_BRAND

def trade_code(b):
    return TRADENAME_CODE.get(brand_name(b), "TN1")

def coll_code(name):
    return COLLECTION_CODE.get(slug(fix_coll(name)), "")

def cat_codes(subtype_string):
    """Comma-separated category CODES (multi-category supported with auto-create off)."""
    out = []
    for tok in (subtype_string or "").split(","):
        c = TOKEN_CODE.get(tok.strip())
        if c and c not in out:
            out.append(c)
    return ",".join(out)

# finalize Weiyan taxonomy as codes (brand already realigned to its collection above)
for w in weiyan_rows:
    w["TradeNameCode"] = trade_code(w["TradeNameCode"])
    w["CollectionCodes"] = coll_code(w["CollectionCodes"])
    w["CategoryCodes"] = WEIYAN_CAT_CODE

# ---- accessories sold as standalone products (also kept as options) --------
# Verified against the Accessories tab. Two classes:
#   OPTION-backed (shade/dark-sky/turtle/wind-guard): also live in OptionSet7/8,
#     so RelatedItems is derived from real option membership (which lanterns offer it).
#   NON-option (bulbs + gas line cover): no option link; RelatedItems proposed by
#     family default below and flagged for client sign-off.
ACC_OPTION_PRODUCTS = ["ADS", "CSHI", "HSI1", "HSI2", "TLA", "WGS", "WGL"]
ACC_OTHER_PRODUCTS  = ["GLC", "703001", "703002", "LL-TUBE6", "LL-TUBE8", "FB1", "FB12V", "FBBM1"]
ACC_PRODUCT_SET = set(ACC_OPTION_PRODUCTS) | set(ACC_OTHER_PRODUCTS)
ACC_NAME_OVERRIDE = {
    "HSI1": "Frosted Hurricane Shade", "HSI2": "Sanded Hurricane Shade",
    "CSHI": "Cylinder Hurricane Shade", "TLA": "Turtle Light Adapter",
    "ADS": "Adhara Dark Sky Shade", "WGS": "Wind Guard Small", "WGL": "Wind Guard Large",
}

# flat option-code set per SKU (for RelatedItems lookup)
flat_codes = {}
for sku, b in prod_buckets.items():
    s = set()
    for t in NONFIN_TYPES:
        s.update(b.get(t, []))
    flat_codes[sku] = s

# reverse index: accessory option code -> sorted lanterns that offer it
acc_to_lanterns = {a: [] for a in ACC_OPTION_PRODUCTS}
for sku in [p["BaseItemCode"].strip() for p in products] + [w["BaseItemCode"] for w in weiyan_rows]:
    for a in ACC_OPTION_PRODUCTS:
        if a in flat_codes.get(sku, ()):
            acc_to_lanterns[a].append(sku)

# build accessory product rows from the Accessories tab (single source of truth)
def _num(s):
    return (s or "").replace("$", "").replace(",", "").strip()

accessory_rows = []
acc_images_needed = []   # [filename, sku, source_url]
_seen_acc = set()
with open(SRC + "Accessories-Table 1.csv", newline="", encoding="utf-8-sig") as f:
    _arows = [r for r in list(csv.reader(f))[2:] if r and r[0].strip()]
for r in _arows:
    sku = r[0].strip()
    if sku not in ACC_PRODUCT_SET or sku in _seen_acc:
        continue
    _seen_acc.add(sku)
    cat = ACC_CAT_CODE.get(r[4].strip(), "")
    name = ACC_NAME_OVERRIDE.get(sku, r[2].strip())
    gtin = r[3].strip()
    imgurl = r[9].strip() if len(r) > 9 else ""
    imgfile = (sku.lower().replace("/", "-") + ".jpg") if imgurl else ""
    acc_images_needed.append([imgfile or "(MISSING)", sku, imgurl])
    accessory_rows.append({
        "BaseItemCode": sku, "LongDesc": name, "ShortDesc": "",
        # all three are REQUIRED; accessories sit under their own Accessories collection (COL48)
        "TradeNameCode": "TN1", "CollectionCodes": ACC_COLLECTION_CODE, "CategoryCodes": cat,
        "Hideable": "N", "RelatedItems": "", "materials": "", "dimensions": "",
        "shipweight": "", "UPCValue": gtin, "ImageFileName": imgfile,
        "NetPrice": _num(r[5]), "Price_MAP": _num(r[6]), "Price_MSRP": _num(r[7]),
    })

not_in_master = []

# ---- assign group codes (dedup per type) -----------------------------------
type_groups = {t: {} for t in NONFIN_TYPES}   # type -> {tuple(codes): groupcode}
type_counter = {t: 0 for t in NONFIN_TYPES}

def group_for(t, codes):
    if not codes:
        return ""
    key = tuple(codes)
    d = type_groups[t]
    if key not in d:
        type_counter[t] += 1
        d[key] = f"{TYPE_SLOT[t][1]}{type_counter[t]:03d}"
    return d[key]

# stable iteration: existing products first (file order), then weiyan
ordered_skus = [p["BaseItemCode"].strip() for p in products] + [w["BaseItemCode"] for w in weiyan_rows]
prod_optionsets = {}
for sku in ordered_skus:
    b = prod_buckets.get(sku, {t: [] for t in NONFIN_TYPES})
    slots = {}
    # finish
    fin = "FIN001" if prod_finish.get(sku) == "copper" else "FIN002"
    slots[1] = fin
    for t in NONFIN_TYPES:
        idx = TYPE_SLOT[t][0]
        slots[idx] = group_for(t, b.get(t, []))
    prod_optionsets[sku] = slots

# ---- write option_groups.csv ----------------------------------------------
grp_rows = []
grp_rows.append(["FIN001", "Finish - Copper Body", ",".join(FIN_COPPER), "", ""])
grp_rows.append(["FIN002", "Finish - Brass Body", ",".join(FIN_BRASS), "", ""])
for t in NONFIN_TYPES:
    for key, code in sorted(type_groups[t].items(), key=lambda kv: kv[1]):
        grp_rows.append([code, f"{t} {code[len(TYPE_SLOT[t][1]):]}", ",".join(key), "", ""])

with open(os.path.join(OUT_DIR, "option_groups.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["Code", "Name", "Options", "PriceAddend", "PriceFactor"])
    wcsv.writerows(grp_rows)

# ---- write options.csv (cleaned Description = type, names fixed) ------------
used_codes = set(FIN_COPPER) | set(FIN_BRASS)
for t in NONFIN_TYPES:
    for key in type_groups[t]:
        used_codes.update(key)

with open(os.path.join(OUT_DIR, "options.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["Code", "Name", "SortValue", "Description", "ImageName", "PriceAddend", "PriceFactor"])
    for code in sorted(options):
        o = options[code]
        t = code_type(code) or o.get("Description", "")
        # swatch: keep an explicit source ImageName, else map to an existing live family swatch
        img = o.get("ImageName", "").strip()
        if not img:
            sw, conf = swatch_for(code)
            if sw and sw in EXISTING_SWATCHES and conf == "high":
                img = sw + ".jpg"
        wcsv.writerow([code, o.get("Name", ""), o.get("SortValue", ""),
                       t, img, o.get("PriceAddend", ""), o.get("PriceFactor", "")])

# ---- write products.csv ----------------------------------------------------
SCHEMA = ["BaseItemCode", "LongDesc", "ShortDesc", "TradeNameCode", "CollectionCodes",
          "CategoryCodes", "Hideable", "RelatedItems", "materials", "dimensions", "shipweight",
          "UPCValue", "ImageFileName",
          "NetPrice", "Price_MAP", "Price_MSRP",
          "OptionSet1", "OptionSet1Required", "OptionSet2", "OptionSet3", "OptionSet4",
          "OptionSet5", "OptionSet6", "OptionSet7", "OptionSet8",
          "Genre", "Subcategory", "GasElectricDual", "SecondaryFinish", "GlassFeatures",
          "Extension", "BackplateWidth", "BackplateHeight", "CanopyWidth", "CanopyHeight",
          "BulbBase", "BulbCount", "WattsPerBulb", "TotalWattage", "Voltage", "BulbIncluded",
          "BulbTypeRequired", "MarineGrade", "DarkSky", "LocationRating", "ADA", "Certifications",
          "Title20", "Title24", "Prop65", "SpecSheet", "MarketingCopy", "Warranty", "CountryOfOrigin"]

def emit_row(base):
    sku = base["BaseItemCode"].strip()
    slots = prod_optionsets[sku]
    row = dict(base)
    row["OptionSet1"] = slots[1]
    row["OptionSet1Required"] = "Y"
    for n in range(2, 9):
        row[f"OptionSet{n}"] = slots.get(n, "")
    return row

out_products = []
img_filled = 0
for p in products:
    sku = p["BaseItemCode"].strip()
    base = dict(p)
    # ShortDesc is the standard template field name; keep the source value under it
    base["ShortDesc"] = p.get("ShortDesc", "")
    # (#5) restore brand-prefixed LongDesc from the master Retailer Product Name
    nm = master_name.get(sku)
    if nm and nm[0]:
        base["LongDesc"] = make_longdesc(nm[0], nm[1])
    # taxonomy (auto-create OFF): emit existing Admin CODES; multi-category allowed
    #   TradeNameCode  = TN1 / TN2
    #   CollectionCodes= COL## (one collection per item)
    #   CategoryCodes  = comma-separated CAT## (a product can be in several Product Types)
    mt = master_tax.get(nkey(sku))
    if mt:
        base["TradeNameCode"] = trade_code(mt["brand"])
        base["CollectionCodes"] = coll_code(mt["collection"])
        base["CategoryCodes"] = cat_codes(mt["subtype"])
    else:
        not_in_master.append(sku)
        base["TradeNameCode"] = ""
        base["CollectionCodes"] = ""
        base["CategoryCodes"] = ""
    # related: surface productized accessories this lantern offers as options,
    # plus family-default bulbs/cover (non-option accessories) by fuel type.
    # Use the master Fixture Sub-Type tokens (not the single displayed category,
    # which may be 'Flush Mount' for a flush-mount gas/electric lantern).
    carried = [a for a in ACC_OPTION_PRODUCTS if a in flat_codes.get(sku, ())]
    subtoks = [t.strip() for t in ((mt["subtype"] if mt else "") or "").split(",")]
    fam = []
    if "Gas Lanterns" in subtoks:
        fam.append("GLC")
    if "Electric Lanterns" in subtoks:
        fam += ["703001", "703002"]
    existing_ri = [x.strip() for x in (base.get("RelatedItems", "") or "").split(",") if x.strip()]
    base["RelatedItems"] = ",".join(dict.fromkeys(existing_ri + carried + fam))
    # fill blank image from master
    if not base.get("ImageFileName", "").strip():
        mi = master_img.get(sku, "")
        if mi:
            base["ImageFileName"] = mi.lower() + ".jpg"
            img_filled += 1
    out_products.append(emit_row(base))

for w in weiyan_rows:
    sku = w["BaseItemCode"]
    carried = [a for a in ACC_OPTION_PRODUCTS if a in flat_codes.get(sku, ())]
    # Weiyan LED fixtures take the flame bulbs (family default), not the 6-pack LED
    fam = ["FB1", "FB12V"]
    existing_ri = [x.strip() for x in (w.get("RelatedItems", "") or "").split(",") if x.strip()]
    w["RelatedItems"] = ",".join(dict.fromkeys(existing_ri + carried + fam))
    out_products.append(emit_row(w))

# accessory products: standalone rows, no option sets
def emit_accessory(base):
    row = dict(base)
    row["OptionSet1"] = ""
    row["OptionSet1Required"] = ""
    for n in range(2, 9):
        row[f"OptionSet{n}"] = ""
    return row

for a in accessory_rows:
    out_products.append(emit_accessory(a))

with open(os.path.join(OUT_DIR, "products.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.DictWriter(f, fieldnames=SCHEMA, extrasaction="ignore")
    wcsv.writeheader()
    for r in out_products:
        wcsv.writerow(r)

# ---- write accessory_images_needed.csv (FTP filename <- CDN source url) -----
with open(os.path.join(OUT_DIR, "accessory_images_needed.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["ImageFileName", "AccessorySKU", "SourceURL"])
    wcsv.writerows(acc_images_needed)

# ---- write taxonomy_admin_setup.csv (rename/reparent/create reference) ------
# Doubles as an importable taxonomies.csv (Type,ParentCode,Code,Name) AND a manual
# checklist: 'Action' tells you whether each row already exists (rename/reparent)
# or must be created. Codes match what the product file now emits.
live_names = {  # current ugly labels in Admin (so you can see what changes)
    "TN1": "CS", "TN2": "CSB", "OL": "Outdoor Lighting", "ACC": "Accessories",
    "CAT1": "SCONCE", "CAT3": "FLUSH_MOUNT", "CAT4": "ELECTRIC_LANTERNS",
    "CAT5": "GAS_LANTERNS", "CAT7": "LED_FIXTURES",
}
# collection display names by code (slug -> code already known; reverse via master)
coll_display = {}
for r in dataM:
    nm = fix_coll(g(r, m_coll))
    c = COLLECTION_CODE.get(slug(nm))
    if c and c not in coll_display:
        coll_display[c] = nm
        live_names[c] = slug(nm)            # current Admin label is the UPPER_SNAKE string

tax_ref = []  # (Type, ParentCode, Code, Name, CurrentLabel, Action)
def _action(code, parent_needed):
    if code not in live_names:
        return "CREATE"
    return "RENAME/REPARENT"
# tradenames + groups
for code in ["TN1", "TN2", "OL", "ACC"]:
    typ, par, nm = TAXONOMY_NICE[code]
    tax_ref.append([typ, par, code, nm, live_names.get(code, ""), _action(code, False)])
# collections (parented to its tradename)
for sl, code in sorted(COLLECTION_CODE.items(), key=lambda kv: kv[1]):
    nm = coll_display.get(code, sl.title())
    par = "TN2" if slug(nm).startswith("BILTMORE") or nm == "Traveler" else "TN1"
    tax_ref.append(["Collection", par, code, nm, live_names.get(code, ""), "RENAME"])
# accessories collection (new)
tax_ref.append(["Collection", "TN1", ACC_COLLECTION_CODE, "Accessories", "", "CREATE"])
# categories
for code in ["CAT5", "CAT4", "CAT3", "CAT2", "CAT1", "CAT6", "CAT7", "CAT8", "CAT9", "CAT10"]:
    typ, par, nm = TAXONOMY_NICE[code]
    tax_ref.append([typ, par, code, nm, live_names.get(code, ""), _action(code, True)])

with open(os.path.join(OUT_DIR, "taxonomy_admin_setup.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["Type", "ParentCode", "Code", "Name", "CurrentAdminLabel", "Action"])
    wcsv.writerows(tax_ref)

# clean importable taxonomies.csv (locks the exact codes the product file uses;
# upserts existing codes = rename/reparent, creates the new ones). Import BEFORE products.csv.
with open(os.path.join(OUT_DIR, "taxonomies.csv"), "w", newline="", encoding="utf-8") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["Type", "ParentCode", "Code", "Name"])
    for row in tax_ref:
        wcsv.writerow(row[:4])

# ---- diagnostics -----------------------------------------------------------
lantern_rows = out_products[:len(products) + len(weiyan_rows)]
print("Products written:", len(out_products),
      "(existing", len(products), "+ weiyan", len(weiyan_rows), "+ accessories", len(accessory_rows), ")")
print("Images filled from master:", img_filled)
print("Weiyan rows with blank image:", sum(1 for w in weiyan_rows if not w["ImageFileName"]))
print("Group counts:", {t: type_counter[t] for t in NONFIN_TYPES}, "+ 2 finish")
print("Total option groups:", len(grp_rows))
print("Options written:", len(options))
print("Weiyan unknown (non-catalog) codes skipped:", dict(weiyan_unknown))

# ---- taxonomy diagnostics (auto-create: names; every product needs all 3) --
build_skus = {nkey(p["BaseItemCode"]) for p in products} | {nkey(w["BaseItemCode"]) for w in weiyan_rows}
master_missing = [g(r, m_sku) for r in dataM if g(r, m_sku) and nkey(g(r, m_sku)) not in build_skus]
missing_required = [r["BaseItemCode"] for r in out_products
                    if not (r.get("TradeNameCode") and r.get("CollectionCodes") and r.get("CategoryCodes"))]
print()
print("--- taxonomy (auto-create OFF / Admin codes) ---")
print("TradeNameCode distinct:", dict(collections.Counter(r["TradeNameCode"] for r in out_products)))
print("CollectionCodes distinct:", len(set(r["CollectionCodes"] for r in out_products)))
# count category MEMBERSHIPS (multi-category now)
catmem = collections.Counter()
for r in out_products:
    for c in r["CategoryCodes"].split(","):
        if c:
            catmem[c] += 1
print("Category memberships (multi-category):", dict(catmem))
multi_n = sum(1 for r in out_products if "," in r["CategoryCodes"])
print("Products in 2+ categories (multi-category working):", multi_n)
print("Products missing a REQUIRED taxonomy field (would error on import):",
      len(missing_required), missing_required[:20])
# every code the product file emits must exist in Admin / the setup reference
defined = set(COLLECTION_CODE.values()) | set(TOKEN_CODE.values()) | {WEIYAN_CAT_CODE} \
          | set(ACC_CAT_CODE.values()) | set(TRADENAME_CODE.values()) | {ACC_COLLECTION_CODE}
emitted = set()
for r in out_products:
    emitted.add(r["TradeNameCode"]); emitted.add(r["CollectionCodes"])
    emitted.update(c for c in r["CategoryCodes"].split(",") if c)
emitted.discard("")
print("Emitted codes NOT in the Admin setup reference:", sorted(emitted - defined) or "NONE")
print("Existing products NOT found in E+G master (taxonomy blanked):",
      len(not_in_master), not_in_master[:20])
print("Master E+G SKUs NOT in build (deferred - conversion kits/accessories):",
      len(master_missing), master_missing[:20])

# ---- accessory diagnostics -------------------------------------------------
print()
print("--- accessories (standalone products, also options where applicable) ---")
print("Accessory products written:", len(accessory_rows),
      dict(collections.Counter(a["CategoryCodes"] for a in accessory_rows)))
print("Option-backed RelatedItems coverage:",
      {a: len(acc_to_lanterns[a]) for a in ACC_OPTION_PRODUCTS})
acc_missing_img = [a[1] for a in acc_images_needed if a[0] == "(MISSING)"]
print("Accessory products needing an image source:", acc_missing_img)
fam_wired = {
    "GLC": sum(1 for r in lantern_rows if "GLC" in r["RelatedItems"].split(",")),
    "703001/703002": sum(1 for r in lantern_rows if "703001" in r["RelatedItems"].split(",")),
    "FB1/FB12V": sum(1 for r in lantern_rows if "FB1" in r["RelatedItems"].split(",")),
}
print("Family-default bulb/cover wiring (lanterns linked):", fam_wired)
print("Still unwired (no source mapping):", ["LL-TUBE6", "LL-TUBE8", "FBBM1"])
