eCat_Onboarding/**/*.jpeg
eCat_Onboarding/**/*.png
eCat_Onboarding/**/images/
eCat_Onboarding/**/images_to_upload*/
eCat_Onboarding/**/FTP_Upload_Images/
eCat_Onboarding/**/1_ Collection Images/
# Raw source exports — on disk, not in git
eCat_Onboarding/**/Source Data/
eCat_Onboarding/**/*.xlsx
eCat_Onboarding/**/*.xls

# ── Client data — never commit ──────────────────────────────────────────────
**/customers.csv
**/Ready_For_Import/*.csv

# ── Transcript archives ──────────────────────────────────────────────────────
*transcript*.zip
ecat-onboarding-transcripts-MERGED-*

# ── Secrets & credentials ────────────────────────────────────────────────────
.env
.env.*
*service-account*.json

# ── OS / tooling noise ───────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.pyc
*.pyo

