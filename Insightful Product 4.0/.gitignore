# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (37MB — reproduce from requirements-pipeline.txt)
.venv-renderer/
.venv/
venv/
env/

# Pipeline runtime data (immutable per dated dir, but not source)
pipeline/cache/*/
!pipeline/cache/.gitkeep
pipeline/cohort_runs/*/
!pipeline/cohort_runs/.gitkeep

# Secrets / env
.env
.env.local
*.env

# Editor cruft
.idea/
.vscode/
*.swp
*.swo
*~

# Build / dist
build/
dist/
*.egg

# ── Client deliverables & baselines — NEVER tracked (2026-09-16) ────────────
# outputs/ holds real client CEO briefs: named accounts, named reps, exact
# revenue. Every file carries "Confidential — prepared for <client> use only".
# They are build artifacts, reproducible in ~1s from pipeline/cache/.
# _baseline/ and _current/ hold the same client text for the regression
# harness; regenerate with ./tools/cohort_run.sh (~10s), never commit.
outputs/*
!outputs/.gitkeep
# EXCEPT the authored prose inputs. `{org}_prose_{date}.json` is hand-written
# source the pipeline CANNOT regenerate — not a build artifact. Ignoring it
# once already cost the P0-1 fixes when a branch switch deleted the untracked
# copies. These move to the private client-data repo at Phase 11.
!outputs/*_prose_*.json
_baseline/
_current/
